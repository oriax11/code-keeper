*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.python-version

# Ansible execution & cache artifacts
.ansible/
*.cache
fact_cache/

# Testing & Molecule artifacts
.molecule/
.pytest_cache/
.tox/

